   "source": [
    "# ── CELDA 2: Configurar paths ──\n",
    "import sys\n",
    "BASE = \'/content/drive/MyDrive/retinal_segmentation\'\n",
    "sys.path.insert(0, f\'{BASE}/src\')\n",
    "import torch\n",
    "device = torch.device(\'cuda\' if torch.cuda.is_available() else \'cpu\')\n",
    "print(f\'Device: {device}\')"
   ],
   "execution_count": null, "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELDA 3: Cargar datos ──\n",
    "from dataset import crear_dataloaders\n",
    "train_loader, val_loader, test_loader, chase_loader = crear_dataloaders(\n",
    "    BASE, batch_size=4, tam=256)\n",
    "print(\'✅ DataLoaders listos\')"
   ],
   "execution_count": null, "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELDA 4: Entrenar 3 experimentos ──\n",
    "from model import UNet, AttentionUNet\n",
    "from train import entrenar\n",
    "import json\n",
    "\n",
    "experimentos = [\n",
    "    (UNet,          \'unet_bce_dice\',          \'bce_dice\'),\n",
    "    (UNet,          \'unet_dice\',               \'dice\'),\n",
    "    (AttentionUNet, \'attention_unet_bce_dice\',  \'bce_dice\'),\n",
    "]\n",
    "\n",
    "historiales = {}\n",
    "for ClaseModelo, nombre, perdida in experimentos:\n",
    "    modelo = ClaseModelo(canales_entrada=3, canales_salida=1, dropout=0.1)\n",
    "    config = {\n",
    "        \'device\': device, \'epochs\': 60, \'lr\': 1e-3,\n",
    "        \'perdida\': perdida, \'paciencia\': 15,\n",
    "        \'checkpoint_dir\': f\'{BASE}/checkpoints\',\n",
    "        \'nombre_experimento\': nombre,\n",
    "    }\n",
    "    historiales[nombre] = entrenar(modelo, train_loader, val_loader, config)\n",
    "    with open(f\'{BASE}/results/metrics/historial_{nombre}.json\',\'w\') as f:\n",
    "        json.dump(historiales[nombre], f)\n",
    "print(\'✅ Entrenamiento completo\')"
   ],
   "execution_count": null, "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELDA 5: Evaluación completa ──\n",
    "from evaluate import evaluar_modelo, tabla_comparativa, graficar_roc\n",
    "from evaluate import graficar_confusion, analizar_fallos\n",
    "import os, cv2, numpy as np\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import albumentations as A\n",
    "from albumentations.pytorch import ToTensorV2\n",
    "\n",
    "class DRIVEEvalCompleto(Dataset):\n",
    "    def __init__(self, base_dir, tam=256):\n",
    "        img_dir  = f\'{base_dir}/data/DRIVE/training/images\'\n",
    "        mask_dir = f\'{base_dir}/data/DRIVE/training/1st_manual\'\n",
    "        imgs  = sorted([f for f in os.listdir(img_dir) if f.endswith(\'.tif\')])\n",
    "        masks = sorted([f for f in os.listdir(mask_dir) if f.endswith(\'.gif\')])\n",
    "        self.pares = [(os.path.join(img_dir,i), os.path.join(mask_dir,m))\n",
    "                      for i,m in zip(imgs,masks)]\n",
    "        self.transform = A.Compose([A.Resize(tam,tam),\n",
    "            A.Normalize(mean=[0.485,0.456,0.406],std=[0.229,0.224,0.225]),\n",
    "            ToTensorV2()])\n",
    "    def __len__(self): return len(self.pares)\n",
    "    def __getitem__(self, idx):\n",
    "        img = cv2.cvtColor(cv2.imread(self.pares[idx][0]), cv2.COLOR_BGR2RGB)\n",
    "        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n",
    "        img[:,:,1] = clahe.apply(img[:,:,1])\n",
    "        mask = (cv2.imread(self.pares[idx][1], cv2.IMREAD_GRAYSCALE)>0).astype(np.float32)\n",
    "        aug = self.transform(image=img, mask=mask)\n",
    "        return aug[\'image\'], aug[\'mask\'].unsqueeze(0)\n",
    "\n",
    "eval_loader = DataLoader(DRIVEEvalCompleto(BASE), batch_size=1, shuffle=False)\n",
    "\n",
    "def cargar(cls, ruta):\n",
    "    m = cls(3,1,0.1)\n",
    "    m.load_state_dict(torch.load(ruta, map_location=device)[\'modelo\'])\n",
    "    return m\n",
    "\n",
    "ckpt = f\'{BASE}/checkpoints\'\n",
    "m1 = cargar(UNet,          f\'{ckpt}/unet_bce_dice_mejor.pth\')\n",
    "m2 = cargar(UNet,          f\'{ckpt}/unet_dice_mejor.pth\')\n",
    "m3 = cargar(AttentionUNet, f\'{ckpt}/attention_unet_bce_dice_mejor.pth\')\n",
    "\n",
    "met1,p1,t1 = evaluar_modelo(m1, eval_loader, device, \'UNet-BCE+Dice\')\n",
    "met2,p2,t2 = evaluar_modelo(m2, eval_loader, device, \'UNet-Dice\')\n",
    "met3,p3,t3 = evaluar_modelo(m3, eval_loader, device, \'AttentionUNet\')\n",
    "\n",
    "todas = [met1,met2,met3]\n",
    "tabla_comparativa(todas, BASE)\n",
    "graficar_roc([(\'UNet-BCE+Dice\',p1,t1),(\'UNet-Dice\',p2,t2),(\'AttentionUNet\',p3,t3)], BASE)\n",
    "mejor = max(todas, key=lambda x: x[\'f1\'])\n",
    "graficar_confusion(mejor, BASE)\n",
    "analizar_fallos(m2, eval_loader, device, BASE, n_ejemplos=5)\n",
    "print(\'✅ Evaluación completa\')"
   ],
   "execution_count": null, "outputs": []
  },
  {
   "cell_type": "code",
