   "source": [
    "# ── CELDA 6: Experimento cross-domain ──\n",
    "from evaluate import evaluar_modelo\n",
    "import json\n",
    "\n",
    "class CHASEEval(Dataset):\n",
    "    def __init__(self, base_dir, tam=256, usar_clahe=False):\n",
    "        self.usar_clahe = usar_clahe\n",
    "        img_dir  = f\'{base_dir}/data/CHASE_DB1/images\'\n",
    "        mask_dir = f\'{base_dir}/data/CHASE_DB1/annotations\'\n",
    "        imgs  = sorted([f for f in os.listdir(img_dir) if f.lower().endswith((\'jpg\',\'.png\'))])\n",
    "        masks = sorted([f for f in os.listdir(mask_dir) if f.lower().endswith((\'png\',\'.gif\'))])\n",
    "        n = min(len(imgs),len(masks))\n",
    "        self.pares = [(os.path.join(img_dir,imgs[i]),os.path.join(mask_dir,masks[i])) for i in range(n)]\n",
    "        self.transform = A.Compose([A.Resize(tam,tam),\n",
    "            A.Normalize(mean=[0.485,0.456,0.406],std=[0.229,0.224,0.225]),ToTensorV2()])\n",
    "    def __len__(self): return len(self.pares)\n",
    "    def __getitem__(self, idx):\n",
    "        img = cv2.cvtColor(cv2.imread(self.pares[idx][0]), cv2.COLOR_BGR2RGB)\n",
    "        if self.usar_clahe:\n",
    "            clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n",
    "            img[:,:,1] = clahe.apply(img[:,:,1])\n",
    "        mask = (cv2.imread(self.pares[idx][1], cv2.IMREAD_GRAYSCALE)>0).astype(np.float32)\n",
    "        aug = self.transform(image=img, mask=mask)\n",
    "        return aug[\'image\'], aug[\'mask\'].unsqueeze(0)\n",
    "\n",
    "chase_sin = DataLoader(CHASEEval(BASE, usar_clahe=False), batch_size=1)\n",
    "chase_con = DataLoader(CHASEEval(BASE, usar_clahe=True),  batch_size=1)\n",
    "\n",
    "mc2,_,_ = evaluar_modelo(m2, chase_sin, device, \'UNet-Dice→CHASE\')\n",
    "ma2,_,_ = evaluar_modelo(m2, chase_con, device, \'UNet-Dice→CHASE+CLAHE\')\n",
    "\n",
    "print(f\'\\nDomain Gap sin CLAHE : {0.7078 - mc2[\'f1\']:.4f}\')\n",
    "print(f\'Domain Gap con CLAHE : {0.7078 - ma2[\'f1\']:.4f}\')\n",
    "print(\'✅ Experimento cross-domain completo\')"
   ],
   "execution_count": null, "outputs": []
  }
 ]
